# Required in production. Do not use the local fallback value.
SKILLMARKET_ADMIN_PASSWORD=replace-with-a-long-random-password

# Required for Telegram webhook replies.
TELEGRAM_BOT_TOKEN=replace-with-rotated-bot-token

# Optional. Defaults to skillmarket_bot.
TELEGRAM_BOT_USERNAME=skillmarket_bot

# Optional local override. Defaults to data/skillmarket.db.
SKILLMARKET_DB_PATH=data/skillmarket.db

# Recommended until a durable database is added.
SKILLMARKET_READONLY_DB=1
